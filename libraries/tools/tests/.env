# This is a test file for the dotenv parser.  It's not a real/production file.
 SPACE = spaced value

HASH_JOINED=alpha#beta
HASH_SPACED=alpha # beta
HASH_QUOTED="alpha # beta"

DOUBLE="double value"
SINGLE='single value'

MULTI="line one
line two"

EMPTY=
DUP=first
DUP=second

MALFORMED LINE
VALID=after

export EXPORTED=exported

BASE=base
DOLLAR=${BASE}-suffix
